{
  "name": "@ink/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "search:rebuild": "tsx --env-file=../../.env src/scripts/rebuild-search-text.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(lint not configured yet)\"",
    "test": "tsx --test src/pieces/routes.test.ts src/pieces/fold.test.ts src/pictures/routes.test.ts src/related/routes.test.ts src/rate-limit.test.ts src/embeddings/embeddings.test.ts src/embeddings/embed-piece.test.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@ink/schemas": "workspace:*",
    "fastify": "^5.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "yjs": "^13.6.33",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
