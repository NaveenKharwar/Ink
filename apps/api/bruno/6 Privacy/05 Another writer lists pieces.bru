meta {
  name: Another writer lists pieces
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/pieces
  body: none
  auth: bearer
}

auth:bearer {
  token: {{secondToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("none of the first writer's pieces", () => {
    const body = JSON.stringify(res.body);
    expect(body).to.not.include(bru.getVar("pieceId"));
    expect(body).to.not.include(bru.getVar("otherPieceId"));
  });
}

docs {
  The second writer's own list. None of the first writer's pieces may be in it.
}
