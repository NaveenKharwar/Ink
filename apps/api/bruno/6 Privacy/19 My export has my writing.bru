meta {
  name: My export has my writing
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/api/export
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("the first writer's own piece is in their export (the check below is not looking at an empty list)", () => {
    [expect(bru.interpolate("{{otherPieceId}}")).to.have.length(36), expect(JSON.stringify(res.body)).to.include(bru.interpolate("{{otherPieceId}}"))];
  });
}

docs {
  Positive control for the next request: "Download all my writing" asks for the writer's pieces a page at a time. Expect 200 with the first writer's piece.
}
