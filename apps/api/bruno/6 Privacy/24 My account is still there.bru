meta {
  name: My account is still there
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/api/export
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("the first writer's piece is still there", () => {
    expect(JSON.stringify(res.body)).to.include(bru.interpolate("{{otherPieceId}}"));
  });
}

docs {
  After the made-up delete link, the first writer can still sign in and their writing is there. Expect 200 with their piece.
}
