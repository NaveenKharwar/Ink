meta {
  name: My picture is still there
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/pictures/{{privatePictureId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

docs {
  Back as the first writer: the picture survived the second writer's attempts. Expect 200.
}
