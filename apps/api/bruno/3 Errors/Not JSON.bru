meta {
  name: Not JSON
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/pieces/{{pieceId}}/sync
  body: text
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  content-type: application/json
}

body:text {
  { not json
}

docs {
  Expect 400: "The request body is not valid JSON."
}
