meta {
  name: Words cannot be patched
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/pieces/{{pieceId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "content": {
      "type": "doc"
    },
    "title": "Sneaky",
    "language": "hi"
  }
}

docs {
  The words, title and language are only written by syncing. None of these are fields here, so this is the same 400 as an empty patch.
}
