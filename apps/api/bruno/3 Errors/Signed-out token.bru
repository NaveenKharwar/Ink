meta {
  name: Signed-out token
  type: http
  seq: 13
}

post {
  url: {{process.env.SUPABASE_URL}}/auth/v1/logout?scope=local
  body: none
  auth: bearer
}

headers {
  apikey: {{process.env.SUPABASE_ANON_KEY}}
}

auth:bearer {
  token: {{throwawayToken}}
}

script:pre-request {
  // A session of its own, so signing it out does not end the one the other requests use.
  const signIn = await bru.sendRequest({
    method: "POST",
    url: bru.getProcessEnv("SUPABASE_URL") + "/auth/v1/token?grant_type=password",
    headers: { apikey: bru.getProcessEnv("SUPABASE_ANON_KEY"), "Content-Type": "application/json" },
    data: { email: bru.getProcessEnv("TEST_EMAIL"), password: bru.getProcessEnv("TEST_PASSWORD") }
  });
  bru.setVar("throwawayToken", signIn.data.access_token);
}

script:post-response {
  // Signing out deletes the sign-in session; the token itself is still signed and unexpired.
  // Only this one session is ended (scope=local); the default would sign the writer out everywhere.
  // A refused request is thrown by sendRequest, so the status is read from the error.
  let status;
  try {
    status = (await bru.sendRequest({
      method: "GET",
      url: bru.getEnvVar("baseUrl") + "/api/pieces",
      headers: { Authorization: "Bearer " + bru.getVar("throwawayToken") }
    })).status;
  } catch (error) {
    status = error.response?.status;
  }
  bru.setVar("signedOutStatus", status);
}

tests {
  test("signing out answers 204", () => expect(res.status).to.equal(204));
  test("the same token is refused right after", () => expect(bru.getVar("signedOutStatus")).to.equal(401));
}

docs {
  This signs a new session of the first user in, signs it out with Supabase, then asks the API for pieces with the same token, which is still signed and not yet expired.
  Expect the sign-out to answer 204 and the API to answer 401: signing out ends access at once. A 200 means a signed-out token still works.
  The session is a throwaway one made just for this request, so your own token keeps working afterwards.
}
