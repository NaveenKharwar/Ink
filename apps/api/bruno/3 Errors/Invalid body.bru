meta {
  name: Invalid body
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/pieces/{{pieceId}}/sync
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "no state vector",
    "language": "klingon"
  }
}

docs {
  Expect 400 invalid_request with an `issues` list: stateVector is required and language must be one of hi, hi-Latn, en, mixed.
}
