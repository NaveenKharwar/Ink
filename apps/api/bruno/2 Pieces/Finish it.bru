meta {
  name: Finish it
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/api/pieces/{{pieceId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "finished"
  }
}

docs {
  PATCH changes everything except the words: title, status, language, isFragment, includeInMemory.
  Only the fields you send change. updatedAt moves forward.
}
