meta {
  name: Finish it
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/api/pieces/{{pieceId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "finished"
  }
}

docs {
  PATCH changes only the flags the server keeps: status, isFragment, includeInMemory.
  The words, title and language are in the Yjs document and are written by syncing. Only the fields you send change. updatedAt moves forward.
}
