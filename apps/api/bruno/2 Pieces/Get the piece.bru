meta {
  name: Get the piece
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/pieces/{{pieceId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("it is the piece asked for", () => expect(JSON.stringify(res.body)).to.include(bru.getVar("pieceId")));
}

docs {
  The full piece, including the editor document in `content`.
}
