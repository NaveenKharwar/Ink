meta {
  name: Open it on a new device (fetch only)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/pieces/{{pieceId}}/sync
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "stateVector": "AA=="
  }
}

assert {
  res.status: eq 200
}

tests {
  test("the answer carries the whole piece", () => expect(res.body.update.length).to.be.greaterThan(20));
}

docs {
  A device that has nothing sends no `update` and an empty state vector (AA==).
  The answer's `update` holds the whole piece.
}
