meta {
  name: Third device wrote at the same time
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/pieces/{{pieceId}}/sync
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "update": "AQPrBwCH6QcAAwlwYXJhZ3JhcGgHAOsHAAYEAOsHASdXcml0dGVuIG9uIHRoZSBsYXB0b3AgYXQgdGhlIHNhbWUgdGltZS4A",
    "stateVector": "AusHKekHQw=="
  }
}

assert {
  res.status: eq 200
}

docs {
  Device C had the poem too but never saw B's change; it wrote a new stanza. Expect BOTH in `piece.text`:
  the phone's addition and the laptop's stanza. Nothing is overwritten.
  The answer's `update` carries B's change, which C was missing.
}
