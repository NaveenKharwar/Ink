meta {
  name: Write a Hindi fragment
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/pieces/{{$randomUUID}}/sync
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "update": "",
    "stateVector": "AA=="
  }
}

docs {
  A new piece (random id): two stanzas in Hindi, language "hi" set inside the document.
  In `piece.text` the stanzas are separated by a blank line.
}
