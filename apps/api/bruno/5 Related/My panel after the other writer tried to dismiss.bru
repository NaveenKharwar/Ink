meta {
  name: My panel after the other writer tried to dismiss
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/pieces/{{pieceId}}/related
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("the other piece is listed", () => expect(JSON.stringify(res.body)).to.include(bru.getVar("otherPieceId")));
}

docs {
  After the second writer's refused dismissal, the first writer's panel still lists the second piece.
}
