meta {
  name: Not related
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/pieces/{{pieceId}}/related/{{otherPieceId}}/dismissed
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 204
}

docs {
  Needs the second piece from "Write a second piece". Expect 204, also when repeated. Run "What Ink sees beside a piece" again: that piece is gone from the lists, and pieceId is gone from the lists of otherPieceId too.
}
