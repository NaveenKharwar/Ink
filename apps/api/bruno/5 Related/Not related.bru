meta {
  name: Not related
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/pieces/{{pieceId}}/related/{{otherPieceId}}/dismissed
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Set otherPieceId (in the collection variables) to the id of another piece of yours. Expect 204, also when repeated. Run "What Ink sees beside a piece" again: that piece is gone from the lists, and pieceId is gone from the lists of otherPieceId too.
}
