meta {
  name: Privacy: another writer's panel never shows mine
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/pieces/{{secondPieceId}}/related
  body: none
  auth: bearer
}

auth:bearer {
  token: {{secondToken}}
}

script:pre-request {
  // Meaning vectors are made in the background a moment after a save. Wait until this panel lists the second
  // writer's own other piece, so "none of the first writer's" is said about a list that has real notes in it.
  const deadline = Date.now() + 30000;
  while (Date.now() < deadline) {
    let answer = { data: "" };
    try {
      answer = await bru.sendRequest({
        method: "GET",
        url: bru.getEnvVar("baseUrl") + "/api/pieces/" + bru.interpolate("{{secondPieceId}}") + "/related",
        headers: { Authorization: "Bearer " + bru.getVar("secondToken") }
      });
    } catch (error) {
      // not there yet, or briefly refused: look again
    }
    if (JSON.stringify(answer.data).includes(bru.interpolate("{{secondOtherPieceId}}"))) break;
    await new Promise((resolve) => setTimeout(resolve, 1500));
  }
}

assert {
  res.status: eq 200
}

tests {
  test("their own other piece is listed, so the list is not just empty", () => expect(JSON.stringify(res.body)).to.include(bru.interpolate("{{secondOtherPieceId}}")));
  test("nothing of the first writer's shows up", () => {
    const body = JSON.stringify(res.body);
    [expect(bru.interpolate("{{pieceId}}")).to.have.length(36), expect(body).to.not.include(bru.interpolate("{{pieceId}}"))];
    [expect(bru.interpolate("{{otherPieceId}}")).to.have.length(36), expect(body).to.not.include(bru.interpolate("{{otherPieceId}}"))];
  });
}

docs {
  As the second writer, after their two similar pieces are written. Waits until this panel lists the second writer's own other piece, then expects 200. No note in related, forgotten or loose may have the id {{pieceId}} or {{otherPieceId}}: those are the first writer's, and their words are almost the same. The list has a real note in it, so "nothing of the first writer's" is not true just because the list is empty.
}
