meta {
  name: Privacy: another writer dismisses my pair
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/pieces/{{pieceId}}/related/{{otherPieceId}}/dismissed
  body: none
  auth: bearer
}

auth:bearer {
  token: {{secondToken}}
}

assert {
  res.status: eq 404
}

docs {
  As the second writer: expect 404, and nothing changes for you. Needs the second piece from "Write a second piece", written by the first writer; without it a 404 proves nothing.
}
