meta {
  name: Get a token
  type: http
  seq: 1
}

post {
  url: {{process.env.SUPABASE_URL}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

headers {
  apikey: {{process.env.SUPABASE_ANON_KEY}}
}

body:json {
  {
    "email": "{{process.env.TEST_EMAIL}}",
    "password": "{{process.env.TEST_PASSWORD}}"
  }
}

script:post-response {
  if (res.status === 200) bru.setVar("token", res.body.access_token);
}

docs {
  Signs in the test user with Supabase and keeps the access token for the other requests.
  Reads SUPABASE_URL, SUPABASE_ANON_KEY, TEST_EMAIL and TEST_PASSWORD from the .env file in this collection folder (git ignores it).
  The token lasts about an hour; run this again when requests start answering 401.
}
