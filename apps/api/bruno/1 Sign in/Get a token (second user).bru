meta {
  name: Get a token (second user)
  type: http
  seq: 3
}

post {
  url: {{process.env.SUPABASE_URL}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

headers {
  apikey: {{process.env.SUPABASE_ANON_KEY}}
}

body:json {
  {
    "email": "{{process.env.SECOND_EMAIL}}",
    "password": "{{process.env.SECOND_PASSWORD}}"
  }
}

script:post-response {
  if (res.status === 200) bru.setVar("secondToken", res.body.access_token);
}

assert {
  res.status: eq 200
}

docs {
  For the privacy check only. Signs in a SECOND writer and saves its token as secondToken. The requests that act as them (the "Privacy" ones) use it; everything else keeps using the first writer's token.
  Needs SECOND_EMAIL and SECOND_PASSWORD in the .env file.
}
