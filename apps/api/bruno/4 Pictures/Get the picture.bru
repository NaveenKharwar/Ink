meta {
  name: Get the picture
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/pictures/{{pictureId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("a private jpeg", () => {
    expect(res.getHeader("content-type")).to.include("image/jpeg");
    expect(res.getHeader("cache-control")).to.include("private");
  });
}

docs {
  Expect 200 with the picture (Content-Type image/jpeg, Cache-Control private).
  Privacy check: sign in as a second user and run this with their token: expect 404.
}
