meta {
  name: List my pictures
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/pictures
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("the picture is listed", () => expect(JSON.stringify(res.body)).to.include(bru.getVar("pictureId")));
}

docs {
  Your pictures, newest first, with totalBytes (the space they take). Only yours: a second user's token lists only theirs.
}
