# Serves the built web app and passes /api to the API, so both share one address.
# SITE_ADDRESS is :8080 by default; set it to a domain name and Caddy gets an HTTPS certificate itself.
{$SITE_ADDRESS}

encode zstd gzip

handle /api/* {
	reverse_proxy {$API_UPSTREAM}
}

# Built files have their content's hash in the name, so they never change; a missing one is a 404.
handle /assets/* {
	root * /srv
	header Cache-Control "public, max-age=31536000, immutable"
	file_server
}

handle {
	root * /srv
	header Cache-Control "no-cache"
	# The app draws every page itself, so an address that is not a file gets index.html.
	try_files {path} /index.html
	file_server
}

header {
	X-Content-Type-Options nosniff
	Referrer-Policy strict-origin-when-cross-origin
	-Server
}
