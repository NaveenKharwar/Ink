# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres (direct connection, for pg-boss / migrations)
DATABASE_URL=
# Path to the database CA certificate (PEM), downloaded from the Supabase dashboard.
# Required in production; without it, development skips certificate verification.
DATABASE_SSL_CA=

# API
PORT=3001

# Embedder service (apps/embedder), e.g. http://127.0.0.1:8001. Optional.
EMBEDDER_URL=

# AI providers (fill in whichever is used)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
