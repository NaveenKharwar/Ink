# Supabase (where each one is: docs/development.md)
SUPABASE_URL=
# The publishable key (sb_publishable_...). The web app uses it.
SUPABASE_ANON_KEY=
# A secret key (sb_secret_...). Only the API uses it; it never reaches a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres (session pooler or direct connection), for the API, its job queue and db:migrate
DATABASE_URL=
# Path to the database CA certificate (PEM), downloaded from the Supabase dashboard.
# Required unless NODE_ENV=development (which `pnpm dev` sets); only then is the certificate check skipped.
# With Docker, the certificate is the file DATABASE_CA_FILE names (default ./database-ca.crt) and this line is not used.
DATABASE_SSL_CA=

# API
PORT=3001

# Embedder service (apps/embedder), e.g. http://127.0.0.1:8001. Optional.
# With Docker, compose.yaml sets EMBEDDER_URL and EMBEDDER_PRIVATE_HOSTS itself; EMBEDDER_SECRET is required.
# Only localhost, a Tailscale (100.64.0.0/10) address or a name under EMBEDDER_PRIVATE_HOSTS is accepted.
EMBEDDER_URL=
# Private network names the embedder may live under, comma-separated (e.g. .railway.internal). Needs two or more parts.
EMBEDDER_PRIVATE_HOSTS=
# Shared secret (16+ characters), the same value for the API and the embedder.
# The embedder requires it when it listens on anything but localhost, so Docker requires it.
# Make one with: openssl rand -hex 24
EMBEDDER_SECRET=

# Seconds a piece must be quiet before it is embedded (default 30). Only the CI checks shorten it.
# EMBED_QUIET_SECONDS=

# The app's address, for the delete-account email link (default http://localhost:5173; the built preview is 4173;
# with Docker, http://localhost:8080 or the INK_PORT below).
APP_URL=
# Resend key that sends that email. Without it, development prints the email in the API terminal.
RESEND_API_KEY=

# Docker only (docs/docker.md). `pnpm dev` does not read these.
# The database certificate file on this machine (default ./database-ca.crt in the repository folder).
# DATABASE_CA_FILE=./database-ca.crt
# The port Ink opens on (default 8080). Pick another when something else already uses 8080.
# INK_PORT=8080
# A domain name for HTTPS on a server: Caddy gets the certificate itself (default :8080, plain HTTP).
# SITE_ADDRESS=ink.example.com
# To keep Docker's values in a file of their own: copy this file to .env.docker, set the line below in it,
# and add --env-file .env.docker to every docker compose command.
# INK_ENV_FILE=.env.docker
